rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User Isolation: Users can only read, write, and delete their own private data
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // One-Time Anti-Abuse Redeem Key Vault:
    // Once created with usedBy = UserA, only UserA can read/write. No other user can overwrite or steal!
    match /redeemed_keys/{keyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.usedBy == request.auth.uid;
      allow update: if request.auth != null && resource.data.usedBy == request.auth.uid;
    }
  }
}
